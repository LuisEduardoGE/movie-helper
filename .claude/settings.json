{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "timeout": 30,
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/session-start.sh\""
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "timeout": 30,
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/session-start.sh\" compact"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Checking whether docs/ai-context needs a sync",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/sync-context-check.sh\""
          },
          {
            "type": "command",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Checking for uncommitted work",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/uncommitted-check.sh\""
          }
        ]
      }
    ]
  }
}
